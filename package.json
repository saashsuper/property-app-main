{
    "private": true,
    "scripts": {
        "clean": "rimraf public/build",
        "dev": "vite",
        "build": "npm run clean && vite build",
        "build-rtl": "rtlcss public/build/css/app.min.css & rtlcss public/build/css/bootstrap.min.css",
        "test:ui": "./run-ui-tests.sh",
        "test:ui:login": "ddev exec php artisan test --filter=test_login_page_contains_required_elements",
        "test:ui:dashboard": "ddev exec php artisan test --filter=test_dashboard_page_contains_required_elements",
        "test:ui:users": "ddev exec php artisan test --filter=test_users_page_contains_required_elements",
        "test:ui:inspections": "ddev exec php artisan test --filter=test_block_inspections_page_contains_required_elements",
        "test:ui:workorders": "ddev exec php artisan test --filter=test_work_orders_page_contains_required_elements",
        "test:ui:blocks": "ddev exec php artisan test --filter=test_blocks_page_contains_required_elements"
    },
    "devDependencies": {
        "@popperjs/core": "^2.11.7",
        "axios": "^1.1.2",
        "bootstrap": "5.3.2",
        "laravel-vite-plugin": "^0.7.2",
        "sass": "^1.56.1",
        "vite": "^4.0.0"
    },
    "dependencies": {
        "browser-sync": "^2.29.1",
        "lodash": "^4.17.21",
        "popper.js": "^1.16.1",
        "postcss": "^8.4.23",
        "postcss-import": "^15.1.0",
        "resolve-url-loader": "^5.0.0",
        "rimraf": "^5.0.5",
        "rtlcss": "^4.1.0",
        "sass-loader": "^13.2.2",
        "vite-plugin-static-copy": "^0.14.0"
    }
}